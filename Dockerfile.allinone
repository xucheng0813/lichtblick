# Build the production Lichtblick Web bundle with the repository-pinned Yarn release.
# --platform=$BUILDPLATFORM：webpack 产物与目标架构无关，构建阶段跑构建机原生架构，
# 避免交叉构建时 esbuild 等原生工具在指令模拟下崩溃；仅运行时阶段使用 --platform 指定的目标架构。
FROM --platform=$BUILDPLATFORM node:22 AS build
# 可选构建参数（不传则 ENV 为空字符串，行为与未定义一致——消费方均为 falsy 检查）：
#   API_URL            viz-server 客户端 API 基础地址，必须带 /lichtblick 前缀
#   DEFAULT_WORKSPACE  构建期默认 workspace（URL > 设置 > 此默认值）
#   COREPACK_NPM_REGISTRY / YARN_NPM_REGISTRY_SERVER
#                      corepack 下载 yarn 与 yarn 拉包所用的 npm 源；默认 registry.npmjs.org
#                      （repo.yarnpkg.com / registry.yarnpkg.com 在部分网络下不可达）
ARG API_URL
ARG DEFAULT_WORKSPACE
ARG COREPACK_NPM_REGISTRY=https://registry.npmjs.org
ARG YARN_NPM_REGISTRY_SERVER=https://registry.npmjs.org
ENV API_URL=$API_URL DEFAULT_WORKSPACE=$DEFAULT_WORKSPACE \
    COREPACK_NPM_REGISTRY=$COREPACK_NPM_REGISTRY \
    YARN_NPM_REGISTRY_SERVER=$YARN_NPM_REGISTRY_SERVER
WORKDIR /src
COPY . ./

RUN corepack enable \
    && yarn install --immutable \
    && yarn web:build:prod

# Run the Web bundle and restricted VTD API from one same-origin Node process.
FROM node:22-slim

ARG VTD_DOWNLOAD_URL
ARG VTD_SHA256

# VTD_DOWNLOAD_URL 应指向可从构建环境访问的内网 vtd-linux-x86 发布地址；
# VTD_SHA256 必须由同一发布流程提供，禁止用未经校验的二进制构建镜像。
RUN test -n "${VTD_DOWNLOAD_URL}" \
    && test -n "${VTD_SHA256}" \
    && apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && curl -fsSL "${VTD_DOWNLOAD_URL}" -o /usr/local/bin/vtd \
    && echo "${VTD_SHA256}  /usr/local/bin/vtd" | sha256sum -c - \
    && chmod 0755 /usr/local/bin/vtd \
    && apt-get purge -y --auto-remove curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --chown=node:node vtd-sidecar/server.mjs /app/server.mjs
COPY --from=build --chown=node:node /src/web/.webpack /app/public

# Static Web and /vtd/* share one origin. The client vtdEndpoint may use this origin,
# or remain unset when viz-server default-config supplies it at runtime.
ENV STATIC_ROOT=/app/public PORT=8080

USER node
EXPOSE 8080

CMD ["node", "/app/server.mjs"]
